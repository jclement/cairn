{
  "name": "Cairn",
  "short_name": "Cairn",
  "description": "Memory for your AI assistants",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
  "share_target": {
    "action": "/app/clip",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
